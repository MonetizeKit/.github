{
  "$schema": "./schemas/agent-policy.schema.json",
  "schema_version": 1,
  "policy_version": "1.0.0",
  "reviewed_at": "2026-09-14",
  "review_due": "2026-12-14",
  "gateway": {
    "provider": "vercel-ai-gateway",
    "base_url": "https://ai-gateway.vercel.sh/v1",
    "models_endpoint": "https://ai-gateway.vercel.sh/v1/models",
    "credential_env": "AI_GATEWAY_API_KEY",
    "anthropic_compatible_base_url": "https://ai-gateway.vercel.sh"
  },
  "tiers": {
    "triage": {
      "purpose": "Short classification and summarisation over logs or diffs: build-failure triage, drift summaries, failure categorisation.",
      "model": "anthropic/claude-haiku-4.5",
      "fallback": "anthropic/claude-sonnet-4.6"
    },
    "review": {
      "purpose": "Code and document review lenses, verification subagents, evals: needs tool use and long context at moderate cost.",
      "model": "anthropic/claude-sonnet-5",
      "fallback": "anthropic/claude-sonnet-4.6"
    },
    "judgment": {
      "purpose": "Security and architecture lenses and the production-promotion summary, where a missed finding is expensive.",
      "model": "anthropic/claude-opus-5",
      "fallback": "anthropic/claude-opus-4.8"
    },
    "second-opinion": {
      "purpose": "The non-Anthropic member of every two-provider quorum.",
      "model": "openai/gpt-5.5",
      "fallback": "openai/gpt-5.4"
    },
    "support": {
      "purpose": "Customer-facing support chat: fast, cheap, no tools, public docs only.",
      "model": "anthropic/claude-haiku-4.5",
      "fallback": "anthropic/claude-sonnet-4.6"
    }
  },
  "roles": {
    "author": {
      "description": "Interactive authoring session (Cursor Cloud Agent, Cursor IDE, Claude Code) writing code against a spec. The engineer chooses the model; this policy governs tools, data and autonomy.",
      "model_selection": "operator",
      "route": "cursor-cloud-agent",
      "tools": ["Bash", "Read", "Write", "Edit", "Grep", "Glob", "WebFetch"],
      "data_classes": ["public", "internal", "secrets-redacted"],
      "autonomy": { "development": "propose", "delivery": "read-only", "production": "read-only" },
      "human_gate": true,
      "owner": "@EtherealVisions",
      "surfaces": ["app-monetizekit-monorepo:AGENTS.md", "app-monetizekit-monorepo:.cursor/hooks.json", "app-monetizekit-monorepo:.claude/settings.json"],
      "status": "active",
      "evals_fixture": "app-monetizekit-monorepo:evals/tasks"
    },
    "planner": {
      "description": "Interactive planning session producing intent.md, plan.md and spec updates from Kiro specs and steering docs. Never edits implementation code.",
      "model_selection": "operator",
      "route": "cursor-cloud-agent",
      "tools": ["Read", "Grep", "Glob", "Write"],
      "data_classes": ["public", "internal"],
      "autonomy": { "development": "propose", "delivery": "none", "production": "none" },
      "human_gate": true,
      "owner": "@EtherealVisions",
      "surfaces": ["app-monetizekit-monorepo:.cursor/commands/kiro-intent.md", "app-monetizekit-monorepo:.cursor/commands/kiro-plan.md", "app-monetizekit-monorepo:.cursor/skills/kiro-planning.md"],
      "status": "active"
    },
    "verifier-subagent": {
      "description": "Fresh-context subagent that re-runs the verification block of AGENTS.md against an author's change and reports pass/fail; it never edits.",
      "model_selection": "policy",
      "tier": "review",
      "model": "anthropic/claude-sonnet-5",
      "fallback": "anthropic/claude-sonnet-4.6",
      "route": "cursor-cloud-agent",
      "tools": ["Bash(pnpm*)", "Bash(git diff*)", "Bash(git status*)", "Read", "Grep", "Glob"],
      "data_classes": ["public", "internal", "secrets-redacted"],
      "autonomy": { "development": "read-only", "delivery": "read-only", "production": "none" },
      "human_gate": false,
      "owner": "@EtherealVisions",
      "surfaces": ["app-monetizekit-monorepo:docs/engineering/agent-delegation-architecture.md"],
      "status": "active"
    },
