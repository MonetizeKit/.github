      "route": "direct-anthropic",
      "budget": { "max_usd_per_run": 15.0, "max_output_tokens": 64000, "max_runs_per_day": 12 },
      "tools": ["Bash(git*)", "Read", "Grep", "Glob", "Write"],
      "data_classes": ["public", "internal", "secrets-redacted"],
      "autonomy": { "development": "read-only", "delivery": "none", "production": "none" },
      "human_gate": false,
      "owner": "@EtherealVisions",
      "surfaces": ["app-monetizekit-monorepo:.github/workflows/stage-review.yml"],
