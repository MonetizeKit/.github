      "model_selection": "policy",
      "tier": "review",
      "model": "anthropic/claude-sonnet-5",
      "fallback": "anthropic/claude-sonnet-4.6",
      "route": "direct-anthropic",
      "budget": { "max_usd_per_run": 2.0, "max_output_tokens": 16000 },
      "tools": ["Bash(git*)", "Read", "Grep", "Glob", "Write"],
